/* Overrides pico-sdk's standard pico_flash_region.ld (which always starts
 * FLASH at 0x10000000) so a target app links into PicoBoot's app
 * partition instead of flash offset 0. Generated by
 * cmake/picoboot_app_linker.cmake's picoboot_set_app_flash_region() from
 * cmake/picoboot_flash_layout.cmake's values -- the single source of
 * truth for PICOBOOT_APP_FLASH_ORIGIN is that file, not this template. */
FLASH(rx) : ORIGIN = @PICOBOOT_APP_FLASH_ORIGIN@, LENGTH = @PICOBOOT_APP_FLASH_LENGTH@
